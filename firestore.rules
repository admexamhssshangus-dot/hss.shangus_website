rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // True authenticated user (not anonymous)
    function isRealUser() {
      return isAuthenticated() &&
        request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email.lower() == 'adm.exam.hss.shangus@gmail.com' ||
        request.auth.token.role == 'SuperAdmin' ||
        request.auth.token.role == 'superadmin'
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        request.auth.token.role == 'Admin' ||
        request.auth.token.admin == true
      );
    }

    function isTeacherOrAdmin() {
      return isAuthenticated() && (
        isAdmin() ||
        request.auth.token.role == 'Teacher' ||
        request.auth.token.role == 'Faculty' ||
        request.auth.token.role == 'teacher' ||
        request.auth.token.role == 'faculty'
      );
    }

    function isSelf(userEmail) {
      return isAuthenticated() && request.auth.token.email.lower() == userEmail.lower();
    }

    // 1. Users collection (Self or Admin)
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isSelf(userId) || isAdmin();
    }

    // 2. Active Admissions & Applications
    match /admissions/{formNo} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    match /admissionApplications/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // 3. Historical Master Registers — readable by any authenticated user (incl. anonymous)
    // Rate limiting in the client + server protect against bulk scraping
    match /masterRegisters/{chunkId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Historical student register data
    match /registerdata/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 4. Form Structure & Subject Config
    match /formStructure/{fieldId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /subjectsConfig/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. Exam & Practicals Settings and Data
    match /examConfig/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /adminPracticalsSettings/{docId} {
      allow read: if isAuthenticated();
      allow write: if isTeacherOrAdmin();
    }
    match /practicalsData/{docId} {
      allow read: if isAuthenticated();
      allow write: if isTeacherOrAdmin();
    }

    // 6. Attendance & Attendance Config
    match /systemSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /attendance/{docId} {
      allow read: if isAuthenticated();
      allow write: if isTeacherOrAdmin();
    }
    match /attendanceConfig/{docId} {
      allow read: if isAuthenticated();
      allow write: if isTeacherOrAdmin();
    }
    match /holidays/{docId} {
      allow read: if isAuthenticated();
      allow write: if isTeacherOrAdmin();
    }

    // 7. System Activity & Email Logs
    // Require real (non-anonymous) authenticated user to write logs
    match /activityLogs/{logId} {
      allow read: if isAuthenticated();
      allow write: if isRealUser();
    }
    match /emailLogs/{logId} {
      allow read: if isAuthenticated();
      allow write: if isRealUser();
    }

    // 8. Rates & Fund Distributions
    match /feeRates/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /fundDistributions/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 9. Site settings & Pages CMS
    match /site/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 10. OMR Exam Registrations (GK Test 2026)
    // - Any authenticated user (incl. anonymous) can CREATE their registration
    // - Any authenticated user can READ (get/list) for duplicate checks & admit card retrieval
    // - Invigilators (anonymous auth) can UPDATE only the OMR photo fields after the exam
    // - Core registration fields are immutable after creation (no update for those)
    // - Only admins can delete (revoke)
    match /omr_registrations/{examNo} {
      allow create: if isAuthenticated();
      allow get: if isAuthenticated();
      allow list: if isAuthenticated();
      // Allow invigilator to write only OMR photo fields; block modification of core fields
      allow update: if isAuthenticated() && (
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['omrPhotoUrl', 'omrUploadedAt', 'omrUploadedBy'])
      );
      allow delete: if isAdmin();
    }

    // 11. GK Test System Settings (Deadline & Open/Closed controls)
    match /gktest_settings/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Fallback: Require authentication for all unlisted document paths
    match /{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
