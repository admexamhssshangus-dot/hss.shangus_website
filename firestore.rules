rules_version = '2';
// Firestore rules: Allow reads publicly. Allow writes for authenticated users
// who either have the `admin` custom claim OR whose email is listed in the
// site/admins document's `emails` array.
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function: check if user is an authorized admin
    function isAdmin() {
      return request.auth != null && (
        // Route 1: Email-based admin (Google Sign-In or verified email)
        (request.auth.token.email_verified == true && (
          request.auth.token.admin == true ||
          request.auth.token.email.lower() in get(/databases/$(database)/documents/site/admins).data.emails
        )) ||
        // Route 2: Phone-based admin (2FA OTP login)
        request.auth.token.phone_number in get(/databases/$(database)/documents/site/admins).data.phones
      );
    }

    match /site/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /messages/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}
