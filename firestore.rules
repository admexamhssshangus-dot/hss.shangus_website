rules_version = '2';

// ===============================================================
// Assumed data model and security boundary
// ===============================================================
// Authority comes from verified Firebase Auth and server-managed UID profiles.
// Admin sessions require a server-verified email proof bound to auth_time.
// Public CMS documents contain no credentials or private student information.
// Private user/admission documents are bound to ownerUid and/or verified email.
// Legacy staff-managed academic documents have dynamic schemas, but client
// writes are limited to signed staff claims and credential fields are rejected.
// Unknown collections and all nested paths are denied by default.

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function normalizedRole() {
      return isAuthenticated() && request.auth.token.role is string
        ? request.auth.token.role.lower()
        : '';
    }

    function authEmail() {
      return isAuthenticated() && request.auth.token.email is string
        ? request.auth.token.email.lower()
        : '';
    }

    function staffProfile() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data : {};
    }
    function verifiedStaffIdentity() {
      return isAuthenticated() && request.auth.token.email_verified == true &&
        staffProfile().get('active', true) == true &&
        request.auth.token.get('auth_time', 0) >= staffProfile().get('validAfter', 0);
    }
    function isBootstrapAdmin() {
      return verifiedStaffIdentity() && authEmail() == 'adm.exam.hss.shangus@gmail.com';
    }
    function hasAdminSession() {
      return isAuthenticated() && exists(/databases/$(database)/documents/adminSessions/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/adminSessions/$(request.auth.uid)).data.authTime == request.auth.token.auth_time &&
        get(/databases/$(database)/documents/adminSessions/$(request.auth.uid)).data.expiresAt > request.time;
    }
    function isAdmin() {
      return verifiedStaffIdentity() && hasAdminSession() &&
        (isBootstrapAdmin() || staffProfile().get('role', '') in ['Admin', 'SuperAdmin']);
    }
    function isSuperAdmin() {
      return isAdmin() && (isBootstrapAdmin() || staffProfile().get('role', '') == 'SuperAdmin');
    }
    function canUseAny(modules) {
      let profile = staffProfile();
      return verifiedStaffIdentity() && hasAdminSession() &&
        (isBootstrapAdmin() || profile.get('role', '') == 'SuperAdmin' ||
          (profile.get('role', '') == 'Admin' && profile.get('perms', []).hasAny(modules.concat(['*']))));
    }
    function canUse(module) { return canUseAny([module]); }
    function isFaculty() {
      return verifiedStaffIdentity() && staffProfile().get('role', '') == 'Teacher';
    }
    function isTeacher() { return isFaculty() || isAdmin(); }
    function canReadStudents() {
      return isFaculty() || (isAdmin() && (isSuperAdmin() || staffProfile().get('perms', []).hasAny([
        '*', 'reports', 'admRegisterSuite', 'customRoster', 'certStudio', 'idCards', 'rollNo', 'practicals', 'attendanceMgmt', 'funds', 'controls', 'gkTest'
      ])));
    }
    function canEditStudents() {
      return canUseAny(['reports', 'admRegisterSuite', 'controls', 'rollNo', 'certStudio']);
    }
    function settingsModule(documentId) {
      return documentId == 'certificateRegistry' ? 'certStudio' :
        documentId == 'attendanceConfig' ? 'attendanceMgmt' :
        documentId == 'admission_register_layout' ? 'admRegisterSuite' :
        documentId == 'rosterFeeRules' ? 'customRoster' :
        documentId == 'idCardConfig' ? 'idCards' : 'controls';
    }
    function collectionModule(collectionName) {
      return collectionName in ['registerdata', 'recycleBin', 'deletedFormsHistory', 'csvImportBatches'] ? 'reports' :
        collectionName in ['examConfig', 'attendanceConfig'] ? 'attendanceMgmt' :
        collectionName in ['feeRates', 'fundDistributions'] ? 'funds' :
        collectionName in ['emailLogs'] ? 'automations' :
        collectionName in ['docStudioTemplates'] ? 'officialLetter' : 'controls';
    }

    function isStudent() {
      return isAuthenticated() && (
        normalizedRole() in ['student', 'user', ''] ||
        isTeacher()
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function ownsEmailDocument(documentId) {
      return isAuthenticated() && request.auth.token.email_verified == true && documentId.lower() == authEmail();
    }

    function ownsAdmission(data) {
      return isAuthenticated() && (
        (('ownerUid' in data) && data.ownerUid == request.auth.uid) ||
        ((!('ownerUid' in data) || data.ownerUid == '') && request.auth.token.email_verified == true && (
          (('emailNormalized' in data) && data.emailNormalized is string && data.emailNormalized.lower() == authEmail()) ||
          (('Email Address' in data) && data['Email Address'] is string && data['Email Address'].lower() == authEmail()) ||
          (('email' in data) && data.email is string && data.email.lower() == authEmail())
        ))
      );
    }

    function uidUnchanged(data) {
      return !('uid' in data) || data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['uid', 'ownerUid', 'createdBy']);
    }

    function userAuthorityNotModified() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'role', 'perms', 'admin', 'isAdmin', 'roles', 'permissions',
        'allowedTabs', 'active', 'validAfter', 'subject', 'teachingSubject', 'assignedClass', 'assignedClasses'
      ]);
    }

    function hasCanonicalUserFieldsOnly(data) {
      return data.keys().hasOnly([
        'uid', 'email', 'name', 'displayName', 'mobile', 'phone', 'role', 'perms', 'residence',
        'requestedRole', 'assignedClass', 'teachingSubject', 'subject', 'designation',
        'academicSession', 'createdAt', 'updatedAt', 'active', 'studentName',
        'classRollNo', 'admNo', 'boardRegNo', 'teacherLoginCount', 'last2StepVerificationDate',
        'lastLoginAt', 'authProvider', 'authProviders', 'validAfter', 'assignedClasses'
      ]);
    }

    function hasNoAuthorityOrSecretFields(data) {
      return !data.keys().hasAny([
        'admin', 'isAdmin', 'role', 'Role', 'roles', 'perms', 'permissions',
        'allowedTabs', 'password', 'Password', 'passwordPlain', 'PasswordPlain',
        'passwordHash', 'PasswordHash', 'pass', 'Pass', 'secret', 'secretKey',
        'keySecret', 'apiKey', 'token', 'refreshToken'
      ]);
    }

    function hasNoCredentialFields(data) {
      return !data.keys().hasAny([
        'password', 'Password', 'passwordPlain', 'PasswordPlain', 'passwordHash',
        'PasswordHash', 'pass', 'Pass', 'secret', 'secretKey', 'keySecret',
        'apiKey', 'token', 'refreshToken'
      ]);
    }

    function hasNoAiSecretFields(data) {
      return !data.keys().hasAny([
        'apiKey', 'apiKeys', 'geminiApiKey', 'geminiKeys', 'aiKeys',
        'geminiApiConfig', 'aiConfig', 'secret', 'secretKey', 'keySecret',
        'accessToken', 'refreshToken'
      ]);
    }

    function hasNoNestedPaymentSecrets(data) {
      return !('paymentGatewayConfig' in data) || data.paymentGatewayConfig == null || (
        data.paymentGatewayConfig is map &&
        (!('cashfree' in data.paymentGatewayConfig) || data.paymentGatewayConfig.cashfree == null || (
          data.paymentGatewayConfig.cashfree is map &&
          !data.paymentGatewayConfig.cashfree.keys().hasAny([
            'secret', 'secretKey', 'appSecret', 'clientSecret', 'accessToken', 'refreshToken'
          ])
        )) &&
        (!('razorpay' in data.paymentGatewayConfig) || data.paymentGatewayConfig.razorpay == null || (
          data.paymentGatewayConfig.razorpay is map &&
          !data.paymentGatewayConfig.razorpay.keys().hasAny([
            'secret', 'secretKey', 'keySecret', 'clientSecret', 'accessToken', 'refreshToken'
          ])
        ))
      );
    }

    function validEmail(value) {
      return value is string && value.size() >= 5 && value.size() <= 254 &&
        value.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
    }

    function validOptionalEmail(data) {
      return !('email' in data) || data.email == null || data.email == '' ||
        validEmail(data.email);
    }

    function validSelfUser(data) {
      return data is map && hasCanonicalUserFieldsOnly(data) &&
        data.keys().hasAll(['email', 'name', 'uid']) &&
        hasNoAuthorityOrSecretFields(data) &&
        uidUnchanged(data) && data.uid == request.auth.uid &&
        validEmail(data.email) && data.email.lower() == authEmail() &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        (!('mobile' in data) || (data.mobile is string && data.mobile.size() <= 20)) &&
        (!('residence' in data) || (data.residence is string && data.residence.size() <= 256)) &&
        (!('requestedRole' in data) || data.requestedRole in ['Student', 'Teacher']) &&
        (!('assignedClass' in data) || (data.assignedClass is string && data.assignedClass.size() <= 30)) &&
        (!('teachingSubject' in data) || (data.teachingSubject is string && data.teachingSubject.size() <= 100)) &&
        (!('designation' in data) || (data.designation is string && data.designation.size() <= 100)) &&
        (!('academicSession' in data) || (data.academicSession is string && data.academicSession.size() <= 20)) &&
        (!('createdAt' in data) || data.createdAt is string || data.createdAt is timestamp) &&
        (!('updatedAt' in data) || data.updatedAt is string || data.updatedAt is timestamp);
    }

    function validSelfUserUpdate(data) {
      return data is map && hasCanonicalUserFieldsOnly(data) &&
        data.keys().hasAll(['email', 'name', 'uid']) &&
        hasNoCredentialFields(data) && uidNotModified() && userAuthorityNotModified() &&
        data.uid == request.auth.uid && validEmail(data.email) &&
        data.email.lower() == authEmail() &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        (!('mobile' in data) || (data.mobile is string && data.mobile.size() <= 20)) &&
        (!('role' in data) || data.role in ['Student', 'Teacher', 'Admin', 'SuperAdmin']) &&
        (!('perms' in data) || (data.perms is list && data.perms.size() <= 50)) &&
        (!('residence' in data) || (data.residence is string && data.residence.size() <= 256)) &&
        (!('requestedRole' in data) || data.requestedRole in ['Student', 'Teacher']) &&
        (!('assignedClass' in data) || (data.assignedClass is string && data.assignedClass.size() <= 30)) &&
        (!('teachingSubject' in data) || (data.teachingSubject is string && data.teachingSubject.size() <= 100)) &&
        (!('designation' in data) || (data.designation is string && data.designation.size() <= 100)) &&
        (!('academicSession' in data) || (data.academicSession is string && data.academicSession.size() <= 20)) &&
        (!('studentName' in data) || (data.studentName is string && data.studentName.size() <= 100)) &&
        (!('classRollNo' in data) || (data.classRollNo is string && data.classRollNo.size() <= 40)) &&
        (!('admNo' in data) || (data.admNo is string && data.admNo.size() <= 40)) &&
        (!('boardRegNo' in data) || (data.boardRegNo is string && data.boardRegNo.size() <= 50)) &&
        (!('teacherLoginCount' in data) || data.teacherLoginCount is int || data.teacherLoginCount is number) &&
        (!('last2StepVerificationDate' in data) || data.last2StepVerificationDate is string || data.last2StepVerificationDate is timestamp) &&
        (!('lastLoginAt' in data) || data.lastLoginAt is string || data.lastLoginAt is timestamp) &&
        (!('active' in data) || data.active is bool) &&
        (!('createdAt' in data) || data.createdAt is string || data.createdAt is timestamp) &&
        (!('updatedAt' in data) || data.updatedAt is string || data.updatedAt is timestamp);
    }

    function validAdminUser(data) {
      return data is map && hasCanonicalUserFieldsOnly(data) && hasNoCredentialFields(data) &&
        (!('email' in data) || validEmail(data.email)) &&
        (!('name' in data) || (data.name is string && data.name.size() <= 100)) &&
        (!('mobile' in data) || (data.mobile is string && data.mobile.size() <= 20)) &&
        (!('role' in data) || data.role in ['Student', 'Teacher', 'Admin', 'SuperAdmin']) &&
        (!('perms' in data) || (data.perms is list && data.perms.size() <= 50)) &&
        (!('residence' in data) || (data.residence is string && data.residence.size() <= 256)) &&
        (!('requestedRole' in data) || data.requestedRole in ['Student', 'Teacher']) &&
        (!('assignedClass' in data) || (data.assignedClass is string && data.assignedClass.size() <= 30)) &&
        (!('teachingSubject' in data) || (data.teachingSubject is string && data.teachingSubject.size() <= 100)) &&
        (!('designation' in data) || (data.designation is string && data.designation.size() <= 100)) &&
        (!('academicSession' in data) || (data.academicSession is string && data.academicSession.size() <= 20)) &&
        (!('studentName' in data) || (data.studentName is string && data.studentName.size() <= 100)) &&
        (!('classRollNo' in data) || (data.classRollNo is string && data.classRollNo.size() <= 40)) &&
        (!('admNo' in data) || (data.admNo is string && data.admNo.size() <= 40)) &&
        (!('boardRegNo' in data) || (data.boardRegNo is string && data.boardRegNo.size() <= 50)) &&
        (!('teacherLoginCount' in data) || data.teacherLoginCount is int || data.teacherLoginCount is number) &&
        (!('last2StepVerificationDate' in data) || data.last2StepVerificationDate is string || data.last2StepVerificationDate is timestamp) &&
        (!('lastLoginAt' in data) || data.lastLoginAt is string || data.lastLoginAt is timestamp) &&
        (!('active' in data) || data.active is bool) &&
        (!('createdAt' in data) || data.createdAt is string || data.createdAt is timestamp) &&
        (!('updatedAt' in data) || data.updatedAt is string || data.updatedAt is timestamp);
    }

    function validContactMessage(data) {
      return data is map &&
        data.keys().hasAll(['name', 'phone', 'subject', 'message', 'createdAt']) &&
        data.keys().hasOnly(['name', 'phone', 'email', 'subject', 'message', 'createdAt']) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 100 &&
        data.phone is string && data.phone.size() >= 7 && data.phone.size() <= 20 &&
        data.subject is string && data.subject.size() >= 2 && data.subject.size() <= 80 &&
        data.message is string && data.message.size() >= 5 && data.message.size() <= 2000 &&
        validOptionalEmail(data) &&
        (data.createdAt is timestamp ||
          (data.createdAt is string && data.createdAt.size() >= 20 && data.createdAt.size() <= 40));
    }

    function validStaffDocument(data) {
      return data is map && data.keys().size() <= 300 &&
        hasNoAuthorityOrSecretFields(data);
    }

    function validCertificateNumberLock(documentId, data) {
      return validStaffDocument(data) && data.keys().size() <= 20 &&
        data.keys().hasAll(['certificateNo', 'regNo', 'regKey', 'status', 'updatedAt']) &&
        data.certificateNo is string && data.certificateNo == documentId &&
        data.certificateNo.matches('^[1-9][0-9]{0,5}$') &&
        data.regNo is string && data.regNo.size() >= 4 && data.regNo.size() <= 50 &&
        data.regKey is string && data.regKey.size() >= 4 && data.regKey.size() <= 50 &&
        data.status in ['Active', 'Revoked'] &&
        data.updatedAt is timestamp &&
        (!('createdAt' in data) || data.createdAt is timestamp) &&
        (!('revokedAt' in data) || data.revokedAt is timestamp) &&
        (!('issueKind' in data) || data.issueKind in ['Original', 'Duplicate']) &&
        (!('previousCertificateNo' in data) || (data.previousCertificateNo is string &&
          (data.previousCertificateNo == '' || data.previousCertificateNo.matches('^[1-9][0-9]{0,5}$')))) &&
        (!('session' in data) || (data.session is string && data.session.size() <= 80)) &&
        (!('className' in data) || (data.className is string && data.className.size() <= 40)) &&
        (!('issueDate' in data) || (data.issueDate is string && data.issueDate.size() <= 20)) &&
        (!('sourceDocument' in data) || (data.sourceDocument is string && data.sourceDocument.size() <= 200));
    }

    function validFundRates(data) {
      return validStaffDocument(data) && data.keys().size() >= 1 && data.keys().size() <= 50;
    }

    function validFundConfig(documentId, data) {
      return documentId == 'subsidiary_accounts' && validStaffDocument(data) &&
        data.keys().hasAll(['accounts', 'defaultSession', 'updatedAt']) &&
        data.keys().hasOnly(['accounts', 'defaultSession', 'updatedAt']) &&
        data.accounts is list && data.accounts.size() >= 1 && data.accounts.size() <= 50 &&
        data.defaultSession is string && data.defaultSession.size() >= 7 && data.defaultSession.size() <= 20 &&
        (data.updatedAt is string || data.updatedAt is timestamp);
    }

    function validFundDistribution(data) {
      return validStaffDocument(data) &&
        data.keys().hasAll([
          'id', 'class', 'date', 'academicSession', 'paidStudents',
          'scienceStudents', 'totalAmount', 'timestamp'
        ]) &&
        data.id is string && data.id.size() >= 8 && data.id.size() <= 120 &&
        data.class in ['9th', '10th', '11th', '12th'] &&
        data.date is string && data.date.size() == 10 &&
        data.academicSession is string && data.academicSession.size() >= 7 && data.academicSession.size() <= 20 &&
        data.paidStudents is int && data.paidStudents > 0 && data.paidStudents <= 5000 &&
        data.scienceStudents is int && data.scienceStudents >= 0 &&
        data.scienceStudents <= data.paidStudents &&
        data.totalAmount is number && data.totalAmount >= 0 &&
        (data.timestamp is string || data.timestamp is timestamp);
    }

    function validPublicSiteDocument(documentId, data) {
      return validStaffDocument(data) &&
        (documentId != 'settings' || !('paymentGatewayConfig' in data) ||
          (data.paymentGatewayConfig is map &&
            (!('cashfree' in data.paymentGatewayConfig) ||
              (data.paymentGatewayConfig.cashfree is map &&
                !data.paymentGatewayConfig.cashfree.keys().hasAny(['secretKey', 'secret', 'appSecret']))) &&
            (!('razorpay' in data.paymentGatewayConfig) ||
              (data.paymentGatewayConfig.razorpay is map &&
                !data.paymentGatewayConfig.razorpay.keys().hasAny(['keySecret', 'secret', 'secretKey'])))));
    }

    function validPublicFaculty(data) {
      return data is map &&
        data.keys().hasAll(['name', 'designation', 'subject', 'department', 'photo']) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.designation is string && data.designation.size() >= 1 && data.designation.size() <= 120 &&
        data.subject is string && data.subject.size() <= 120 &&
        data.department is string && data.department.size() <= 80 &&
        data.photo is string &&
        (data.photo == '' ||
          data.photo.matches('^/slides/[a-zA-Z0-9._-]+\\.(jpg|jpeg|png|webp)$') ||
          data.photo.matches('^https://firebasestorage\\.googleapis\\.com/.*$') ||
          data.photo.matches('^https://[^/]+\\.googleusercontent\\.com/.*$') ||
          data.photo.matches('^data:image/.*$'));
    }

    function validFacultySummary(data) {
      return data is map &&
        data.keys().hasAll(['principalName']) &&
        data.keys().hasOnly(['principalName', 'updatedAt']) &&
        data.principalName is string && data.principalName.size() <= 120 &&
        (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function validOmrRegistration(data) {
      return data is map &&
        data.keys().hasAll(['examNumber', 'name', 'className', 'session', 'status', 'ownerUid']) &&
        data.keys().hasOnly([
          'examNumber', 'boardRegNo', 'formNo', 'mobile', 'name', 'fatherName',
          'className', 'classRollNo', 'session', 'photoUrl', 'isManualEntry',
          'submittedAt', 'status', 'ownerUid'
        ]) &&
        data.ownerUid == request.auth.uid &&
        data.examNumber is string && data.examNumber.matches('^[0-9]{7}$') &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 100 &&
        data.className is string && data.className.size() <= 30 &&
        data.session is string && data.session.size() <= 20 &&
        data.status == 'registered' &&
        (!('mobile' in data) || (data.mobile is string && data.mobile.size() <= 20)) &&
        (!('boardRegNo' in data) || (data.boardRegNo is string && data.boardRegNo.size() <= 50)) &&
        (!('formNo' in data) || (data.formNo is string && data.formNo.size() <= 30)) &&
        (!('photoUrl' in data) || data.photoUrl == null ||
          (data.photoUrl is string && data.photoUrl.size() <= 2048));
    }

    // Public, non-sensitive website content.
    match /site/{documentId} {
      allow get: if documentId in ['settings', 'notices', 'facultySummary', 'slideshow', 'pages'] ||
        documentId.matches('^page_[a-zA-Z0-9_-]{1,64}$');
      allow get: if documentId in ['faculty', 'recycle_bin'] && canUseAny(['controls', 'cms']);
      allow list: if canUseAny(['controls', 'cms']);
      allow create, update: if canUseAny(['controls', 'cms']) && (
        (documentId == 'facultySummary' && validFacultySummary(request.resource.data)) ||
        (documentId != 'facultySummary' && validPublicSiteDocument(documentId, request.resource.data))
      );
      allow delete: if canUseAny(['controls', 'cms']);
    }

    match /siteSettings/{documentId} {
      allow read: if true;
      allow create, update: if canUseAny(['controls', 'cms']) && hasNoCredentialFields(request.resource.data) &&
        hasNoAiSecretFields(request.resource.data) && hasNoNestedPaymentSecrets(request.resource.data);
      allow delete: if canUseAny(['controls', 'cms']);
    }

    // Explicitly published, data-minimised faculty directory.
    match /facultyPublic/{documentId} {
      allow get, list: if true;
      allow create, update: if canUseAny(['controls', 'cms']) && validPublicFaculty(request.resource.data);
      allow delete: if canUseAny(['controls', 'cms']);
    }

    match /users/{userId} {
      allow get: if isSuperAdmin() || isOwner(userId) || ownsEmailDocument(userId);
      allow list: if isSuperAdmin();
      allow create: if isOwner(userId) && validSelfUser(request.resource.data);
      allow update: if isOwner(userId) && validSelfUserUpdate(request.resource.data);
      allow delete: if false;
    }

    match /messages/{messageId} {
      allow create: if validContactMessage(request.resource.data);
      allow read, delete: if canUse('controls');
      allow update: if false;
    }

    match /admissions/{documentId} {
      allow get, list: if canReadStudents() || (isStudent() && ownsAdmission(resource.data));
      // Student writes go through the authenticated admission-workflow server.
      // This prevents browser clients from assigning form numbers, changing
      // review status, bypassing admission windows, or forging timestamps.
      allow create: if canEditStudents() && validStaffDocument(request.resource.data) &&
        (request.resource.data.get('ingestionType', '') != 'admin_express_direct' ||
          get(/databases/$(database)/documents/site/settings).data.get('allowExpressZeroRestrictions', false) == true);
      allow update: if canEditStudents() && validStaffDocument(request.resource.data);
      allow delete: if canUse('reports') || canUse('controls');
    }

    match /admissionApplications/{documentId} {
      // Deprecated legacy path. New applications use /admissions through the
      // server workflow; retain administrator-only access for migration.
      allow read: if canUse('reports');
      allow create, update: if canUse('reports') && validStaffDocument(request.resource.data);
      allow delete: if canUse('reports');
    }

    match /attendance/{documentId} {
      allow read: if isTeacher();
      allow create, update, delete: if false; // validated server commands only
    }

    match /practicalsData/{documentId} {
      allow read: if isTeacher();
      // Existing administrative CSV imports remain available; teacher writes
      // always go through assignment, cohort and lock validation on the server.
      allow create, update: if canUse('practicals') && validStaffDocument(request.resource.data);
      allow delete: if canUse('practicals');
    }

    match /activityLogs/{documentId} {
      allow create: if isTeacher() && validStaffDocument(request.resource.data);
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    match /omr_registrations/{documentId} {
      allow get: if canUse('gkTest') ||
        (isAuthenticated() && resource.data.ownerUid == request.auth.uid);
      allow list: if canUse('gkTest');
      allow create: if isAuthenticated() && validOmrRegistration(request.resource.data) &&
        documentId == request.resource.data.examNumber;
      allow update: if canUse('gkTest') && validStaffDocument(request.resource.data);
      allow delete: if canUse('gkTest');
    }

    match /gktest_settings/{documentId} {
      allow get: if documentId == 'config';
      allow list: if false;
      allow create, update: if canUse('gkTest') && validStaffDocument(request.resource.data);
      allow delete: if canUse('gkTest');
    }

    match /systemSettings/{documentId} {
      allow read: if canUseAny(['controls', settingsModule(documentId)]) && documentId != 'geminiApiConfig';
      allow create, update: if canUseAny(['controls', settingsModule(documentId)]) && documentId != 'geminiApiConfig' &&
        hasNoCredentialFields(request.resource.data) && hasNoAiSecretFields(request.resource.data) &&
        hasNoNestedPaymentSecrets(request.resource.data);
      allow delete: if canUse('controls');
    }

    match /formStructure/{documentId} {
      allow read: if true;
      allow create, update: if canUse('controls') && validStaffDocument(request.resource.data);
      allow delete: if canUse('controls');
    }

    match /subjectsConfig/{documentId} {
      allow read: if true;
      allow create, update: if canUse('subjects') && validStaffDocument(request.resource.data);
      allow delete: if canUse('subjects');
    }

    match /holidays/{documentId} {
      allow read: if isAuthenticated();
      allow create, update: if isTeacher() && validStaffDocument(request.resource.data);
      allow delete: if canUse('attendanceMgmt');
    }

    match /fund_rates/{documentId} {
      allow read: if canUse('funds');
      allow create, update: if canUse('funds') && validFundRates(request.resource.data);
      allow delete: if canUse('funds');
    }

    match /fund_config/{documentId} {
      allow read: if canUse('funds');
      allow create, update: if canUse('funds') && validFundConfig(documentId, request.resource.data);
      allow delete: if canUse('funds');
    }

    match /fund_distributions/{documentId} {
      allow read: if canUse('funds');
      allow create, update, delete: if false; // validated server commands only
    }

    match /studentPhotos/{documentId} {
      // Central photos contain private student data. Students receive only their
      // own hydrated photo through the authenticated admission backend.
      allow read: if canReadStudents();
      allow create, update: if canUse('reports') && validStaffDocument(request.resource.data);
      allow delete: if canUse('reports');
    }

    match /admissionHistory/{documentId} {
      allow read: if canUse('reports');
      allow create, update: if canUse('reports') && validStaffDocument(request.resource.data);
      allow delete: if canUse('reports');
    }

    match /adminPracticalsSettings/{documentId} {
      allow read: if isTeacher();
      allow create, update: if canUse('practicals') && hasNoCredentialFields(request.resource.data);
      allow delete: if canUse('practicals');
    }

    match /masterRegisters/{documentId} {
      allow read: if canReadStudents();
      allow create, update: if canEditStudents() && validStaffDocument(request.resource.data);
      allow delete: if canUse('reports');
    }

    match /generatedDocumentHistory/{documentId} {
      allow read: if isTeacher();
      allow create, update: if isTeacher() && validStaffDocument(request.resource.data);
      allow delete: if canUse('officialLetter');
    }

    match /documentHistory/{documentId} {
      allow read: if isTeacher();
      allow create, update: if isTeacher() && validStaffDocument(request.resource.data);
      allow delete: if canUse('certStudio');
    }

    // Permanent uniqueness ledger: a TC/CC number is owned by exactly one
    // registration number. Revocation retires the number; deletion is denied.
    match /certificateNumberLocks/{certificateNo} {
      allow get, list: if canUse('certStudio');
      allow create: if canUse('certStudio') && validCertificateNumberLock(certificateNo, request.resource.data);
      allow update: if canUse('certStudio') && validCertificateNumberLock(certificateNo, request.resource.data) &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['certificateNo', 'regNo', 'regKey', 'createdAt']) &&
        (resource.data.status != 'Revoked' || request.resource.data.status == 'Revoked');
      allow delete: if false;
    }

    match /{collectionName}/{documentId} {
      allow read: if collectionName in ['registerdata', 'examConfig', 'system_settings', 'attendanceConfig',
        'adminActivityLogs', 'emailLogs', 'feeRates', 'fundDistributions', 'recycleBin', 'deletedFormsHistory',
        'csvImportBatches', 'docStudioTemplates'] &&
        (canUse(collectionModule(collectionName)) || (collectionName == 'csvImportBatches' && canEditStudents()));
      allow create, update: if collectionName in ['registerdata', 'examConfig', 'system_settings', 'attendanceConfig',
        'adminActivityLogs', 'feeRates', 'recycleBin', 'deletedFormsHistory', 'csvImportBatches', 'docStudioTemplates'] &&
        (canUse(collectionModule(collectionName)) || (collectionName == 'csvImportBatches' && canEditStudents())) && validStaffDocument(request.resource.data);
      allow delete: if collectionName in ['registerdata', 'examConfig', 'system_settings', 'attendanceConfig',
        'adminActivityLogs', 'feeRates', 'recycleBin', 'deletedFormsHistory', 'docStudioTemplates'] && canUse(collectionModule(collectionName));
    }
    match /adminSettings/{documentId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }
    match /adminActivityLogs/{documentId} {
      allow create: if isAdmin() && validStaffDocument(request.resource.data);
    }
    match /csvImportBatches/{jobId}/entries/{entryId} {
      allow read: if canEditStudents();
      allow create, update: if canEditStudents() && request.resource.data.keys().hasOnly(['kind', 'locator', 'before', 'after', 'status', 'createdAt', 'restoredAt']) &&
        request.resource.data.locator is map && request.resource.data.before is map && request.resource.data.after is map &&
        request.resource.data.status in ['applied', 'restored'];
      allow delete: if false;
    }
    match /archivalJobs/{jobId} {
      allow read: if canUse('controls');
      allow create, update: if canUse('controls') && validStaffDocument(request.resource.data);
      allow delete: if false;
    }
    match /archivalTrash/{documentId} {
      allow read: if canUse('controls');
      allow create: if canUse('controls') && validStaffDocument(request.resource.data);
      allow update, delete: if false;
    }
    match /securityAuditLogs/{documentId} { allow read: if isSuperAdmin(); allow write: if false; }

    // Server-only verification/rate-limit indexes and every unknown path.
    match /studentVerificationIndex/{document=**} {
      allow read, write: if false;
    }
    // Deterministic registration + class + session lookup documents. These are
    // written only by the authenticated server workflow so clients cannot
    // forge a student's identity or an application association.
    match /studentApplicationIndex/{document=**} {
      allow read, write: if false;
    }
    match /securityRateLimits/{document=**} {
      allow read, write: if false;
    }
    match /admissionSubmissionKeys/{document=**} {
      allow read, write: if false;
    }
    match /admissionAuditLogs/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /adminAuthHandshakes/{handshakeId} {
      allow get: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow list, write: if false;
    }
    match /adminSessions/{userId} {
      allow get: if isOwner(userId);
      allow list, write: if false;
    }
    match /issuedDocuments/{documentId} {
      allow read: if canUse('certStudio');
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
