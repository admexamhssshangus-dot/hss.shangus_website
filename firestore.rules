rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'Admin' ||
        request.auth.token.role == 'SuperAdmin'
      );
    }

    // 1. Users Collection
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // 2. Active Admissions & Student Applications
    match /admissions/{formNo} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    match /admissionApplications/{docId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // 3. Historical Master Registers & Register Data
    match /masterRegisters/{chunkId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    match /registerdata/{docId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // 4. Form Structure & Subject Config
    match /formStructure/{fieldId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }
    match /subjectsConfig/{configId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // 5. Exam & Practicals Data
    match /examConfig/{docId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }
    match /adminPracticalsSettings/{docId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }
    match /practicalsData/{docId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // 6. Attendance & System Settings
    match /systemSettings/{docId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }
    match /attendance/{docId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }
    match /attendanceConfig/{docId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }
    match /holidays/{docId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // 7. System Activity & Email Logs
    match /adminActivityLogs/{logId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }
    match /activityLogs/{logId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }
    match /emailLogs/{logId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // 8. Fee Rates & Fund Distributions
    match /feeRates/{docId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }
    match /fundDistributions/{docId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // 9. Site settings & Pages CMS
    match /site/{docId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // 10. OMR Exam Registrations
    match /omr_registrations/{examNo} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // 11. GK Test System Settings
    match /gktest_settings/{docId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Fallback rule
    match /{document=**} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }
  }
}
