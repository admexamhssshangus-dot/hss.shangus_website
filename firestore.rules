rules_version = '2';
// Firestore rules: Allow reads publicly. Allow writes for authenticated users
// who either have the `admin` custom claim OR whose email is listed in the
// site/admins document's `emails` array.
service cloud.firestore {
  match /databases/{database}/documents {
    match /site/{docId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email_verified == true && (
        request.auth.token.admin == true ||
        request.auth.token.email.lower() == "adm.exam.hss.shangus@gmail.com" ||
        request.auth.token.email.lower() in get(/databases/$(database)/documents/site/admins).data.emails
      );
    }
    match /messages/{docId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null && request.auth.token.email_verified == true && (
        request.auth.token.admin == true ||
        request.auth.token.email.lower() == "adm.exam.hss.shangus@gmail.com" ||
        request.auth.token.email.lower() in get(/databases/$(database)/documents/site/admins).data.emails
      );
    }
  }
}
