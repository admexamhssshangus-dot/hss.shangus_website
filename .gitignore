# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
**/node_modules/
/.pnp
.pnp.js

# testing
/coverage

# production
/build

# misc
.DS_Store
desktop.ini
**/desktop.ini
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local Netlify folder
.netlify
.firebase/

# Ignore local Firebase service account
scripts/serviceAccount.json

# ignore firebase private key
serviceAccountKey.json

# Admin credentials — NEVER commit
public/slides/admins.json
public/slides/messages.json
public/slides/*roster*.csv
public/slides/*private*.json

# Local audit and generated interpreter caches
.codex-audit/
firestore-debug.log
firebase-debug.log
ui-debug.log
**/__pycache__/
*.pyc

# Optimized photo dumps (large assets)
optimized_photos*

# Ignore legacy Apps Script backup directory
/login

# Ignore large excel data dumps (> 100MB) & local backup files
*.xlsx
scripts/*.xlsx
scripts/backup/
scripts/backups/
scripts/*.json
src/data/masterSeedData.json
desktop.ini
*.ini
~$*

# Ignore generated institutional presentation reports, bill annexures, and binary document exports
*.pdf
*.docx
docs/GHSS_Shangus_Platform_Presentation_Principal*
docs/*_Updated.*
Inauguration_Presenter_Notes_GHSS_Shangus.pdf
project_cost_estimate.pdf
omr_system/*.docx
omr_system/*.pdf
omr_system/docs/*.pdf

