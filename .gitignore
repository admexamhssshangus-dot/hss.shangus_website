# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
**/node_modules/
/.pnp
.pnp.js

# testing
/coverage

# production
/build

# misc & OS
.DS_Store
Thumbs.db
desktop.ini
**/desktop.ini
*.ini
~$*
*.bak
*.orig
*.tmp
*.swp
*.swo
*~

# Environment variables and secrets — NEVER commit
.env
.env.*
**/.env
**/.env.*
!**/.env.example

# Local Netlify & Firebase folders
.netlify
.firebase/

# Service accounts, credentials, private keys & secrets — NEVER commit
**/*serviceAccount*.json
**/*service-account*.json
**/*credentials*.json
**/serviceAccountKey.json
**/client_secret*.json
*.pem
*.key
*.p12
*.pfx
*.keystore

# Admin credentials & sensitive local files — NEVER commit
public/slides/admins.json
public/slides/messages.json
public/slides/*roster*.csv
public/slides/*private*.json

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
firestore-debug.log*
firebase-debug.log*
ui-debug.log*

# Python caches and virtual environments
**/__pycache__/
*.pyc
.venv/
venv/
ENV/

# Local audit and generated interpreter caches
.codex-audit/

# Optimized photo dumps (large assets)
optimized_photos*

# Ignore legacy Apps Script backup directory
/login

# Ignore large excel data dumps (> 100MB) & local backup files
*.xlsx
scripts/*.xlsx
scripts/backup/
scripts/backups/
scripts/*.json
src/data/masterSeedData.json

# Ignore generated institutional presentation reports, bill annexures, and binary document exports
*.pdf
*.docx
docs/GHSS_Shangus_Platform_Presentation_Principal*
docs/*_Updated.*
!docs/GHSS_Shangus_Institutional_ERP_Resolution.docx
Inauguration_Presenter_Notes_GHSS_Shangus.pdf
project_cost_estimate.pdf
omr_system/*.docx
omr_system/*.pdf
omr_system/docs/*.pdf

# Local scratch scripts and debug files
scratch/
**/scratch/
