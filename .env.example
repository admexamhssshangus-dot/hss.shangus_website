# Firebase web configuration (public identifiers; restrict the API key by API and domain)
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=

# Firebase App Check / reCAPTCHA Enterprise public site key
REACT_APP_RECAPTCHA_ENTERPRISE_SITE_KEY=
REACT_APP_ENABLE_APPCHECK_DEBUG=false

# Server URLs may be public. Never put passwords, private API keys, signing
# secrets, payment secrets, service-account JSON, or GitHub tokens in REACT_APP_*.
REACT_APP_APPS_SCRIPT_URL=

# Netlify server-only admission/verification configuration. Configure these in
# Netlify Environment Variables; never prefix them with REACT_APP_.
FIREBASE_SERVICE_ACCOUNT_JSON=
ALLOWED_ORIGINS=https://hssshangus.netlify.app

# Optional for npm start: use an already-deployed admission function. Keep this
# unprefixed so it is server-only and never embedded in the React bundle.
ADMISSION_WORKFLOW_DEV_URL=https://hssshangus.netlify.app/.netlify/functions/admission-workflow
REQUIRE_VERIFIED_STUDENT_EMAIL=true
REQUIRE_APP_CHECK=false
