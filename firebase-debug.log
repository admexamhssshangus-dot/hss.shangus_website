[debug] [2026-06-18T08:13:36.316Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/hsssdb/rulesets {"name":"projects/hsssdb/rulesets/dbdbb6f9-e3c4-4938-bb26-51b2e8fa9006","source":{"files":[{"content":"rules_version = '2';\n// Firestore rules: Allow reads publicly. Allow writes for authenticated users\n// who either have the `admin` custom claim OR whose email is listed in the\n// site/admins document's `emails` array.\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    match /site/{docId} {\n      allow read: if true;\n      allow write: if request.auth != null && (\n        request.auth.token.admin == true ||\n        request.auth.token.email in get(/databases/$(database)/documents/site/admins).data.emails\n      );\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-06-18T08:13:36.348639Z","metadata":{"services":["cloud.firestore"]}}
