rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return signedIn() && request.auth.token.role is string
        ? request.auth.token.role.lower()
        : '';
    }

    function verifiedEmail() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function admin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        role() in ['admin', 'superadmin', 'super admin'] ||
        (request.auth.token.email is string &&
         request.auth.token.email.lower() in [
           'adm.exam.hss.shangus@gmail.com',
           'ghssshangus74@gmail.com',
           'e.educational.24@gmail.com',
           'socialshiftz@gmail.com'
         ])
      );
    }

    function teacher() {
      return signedIn() && (
        request.auth.token.teacher == true ||
        role() in ['teacher', 'faculty', 'staff'] ||
        admin()
      );
    }

    function validImage(maxBytes) {
      return request.resource != null &&
        request.resource.size > 0 && request.resource.size <= maxBytes &&
        request.resource.contentType.matches('image/(jpeg|png|webp|jpg)');
    }

    function validDocument(maxBytes) {
      return request.resource != null &&
        request.resource.size > 0 && request.resource.size <= maxBytes &&
        request.resource.contentType in ['application/pdf', 'text/csv'];
    }

    // Public website media is readable, but only admins may mutate it.
    match /slides/{allPaths=**} {
      allow read: if true;
      allow create, update: if admin() && validImage(5 * 1024 * 1024);
      allow delete: if admin();
    }

    // A user can manage only their own profile/application images.
    match /users/{userId}/{fileName} {
      allow read: if signedIn() && (request.auth.uid == userId || teacher());
      allow create, update: if request.auth.uid == userId && validImage(3 * 1024 * 1024);
      allow delete: if request.auth.uid == userId || admin();
    }

    match /admissions/{userId}/{fileName} {
      allow read: if signedIn() && (request.auth.uid == userId || teacher());
      allow create, update: if (request.auth.uid == userId || admin()) &&
        (validImage(512 * 1024) || validDocument(10 * 1024 * 1024));
      allow delete: if request.auth.uid == userId || admin();
    }

    match /omr/{userId}/{fileName} {
      allow read: if signedIn() && (request.auth.uid == userId || teacher());
      allow create, update: if request.auth.uid == userId && validImage(5 * 1024 * 1024);
      allow delete: if request.auth.uid == userId || admin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
