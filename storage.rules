rules_version = '2';
// HSS Shangus — Firebase Storage Security Rules
// Allows public read access for all website media and student assets.
// Allows authenticated users and admins to upload images and files.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
