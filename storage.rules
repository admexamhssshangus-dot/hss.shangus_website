rules_version = '2';
// Storage rules: Allow reads publicly, writes only for admins.
// Matches the Firestore rules pattern — checks custom claim OR emails list.
service firebase.storage {
  match /b/{bucket}/o {
    match /slides/photos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.email in firestore.get(/databases/(default)/documents/site/admins).data.emails
      );
    }
  }
}
