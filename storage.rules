rules_version = '2';
// Storage rules: Allow reads publicly, writes only for admins.
// Matches the Firestore rules pattern — checks custom claim OR emails list.
service firebase.storage {
  match /b/{bucket}/o {
    match /slides/photos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && (
        // Route 1: Email-based admin (Google Sign-In or verified email)
        (request.auth.token.email_verified == true && (
          request.auth.token.admin == true ||
          request.auth.token.email.lower() in firestore.get(/databases/(default)/documents/site/admins).data.emails
        )) ||
        // Route 2: Phone-based admin (2FA OTP login)
        request.auth.token.phone_number in firestore.get(/databases/(default)/documents/site/admins).data.phones
      ) && (
        request.resource == null || (
          request.resource.size < 1 * 1024 * 1024 &&
          request.resource.contentType.matches('image/.*')
        )
      );
    }
  }
}
