rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function verifiedEmail() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function profile() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }
    function activeStaff() {
      return verifiedEmail() && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
        profile().get('active', true) == true && request.auth.token.auth_time >= profile().get('validAfter', 0);
    }
    function admin() {
      return verifiedEmail() &&
        ((request.auth.token.email == 'adm.exam.hss.shangus@gmail.com' &&
          (!firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) || activeStaff())) ||
          (activeStaff() && profile().role in ['Admin', 'SuperAdmin'])) &&
        firestore.exists(/databases/(default)/documents/adminSessions/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/adminSessions/$(request.auth.uid)).data.authTime == request.auth.token.auth_time &&
        firestore.get(/databases/(default)/documents/adminSessions/$(request.auth.uid)).data.expiresAt > request.time;
    }
    function teacher() { return admin() || (activeStaff() && profile().role == 'Teacher'); }
    function cms() {
      return admin() && (request.auth.token.email == 'adm.exam.hss.shangus@gmail.com' ||
        profile().role == 'SuperAdmin' || profile().get('perms', []).hasAny(['*', 'controls', 'cms']));
    }

    function validImage(maxBytes) {
      return request.resource != null &&
        request.resource.size > 0 && request.resource.size <= maxBytes &&
        request.resource.contentType.matches('image/(jpeg|png|webp|jpg)');
    }

    function validDocument(maxBytes) {
      return request.resource != null &&
        request.resource.size > 0 && request.resource.size <= maxBytes &&
        request.resource.contentType in ['application/pdf', 'text/csv'];
    }

    // Public website media is readable, but only admins may mutate it.
    match /slides/{allPaths=**} {
      allow read: if true;
      allow create, update: if cms() && validImage(5 * 1024 * 1024);
      allow delete: if cms();
    }

    // A user can manage only their own profile/application images.
    match /users/{userId}/{fileName} {
      allow read: if signedIn() && (request.auth.uid == userId || teacher());
      allow create, update: if request.auth.uid == userId && validImage(3 * 1024 * 1024);
      allow delete: if request.auth.uid == userId || admin();
    }

    match /admissions/{userId}/{fileName} {
      allow read: if signedIn() && (request.auth.uid == userId || teacher());
      allow create, update: if (request.auth.uid == userId || admin()) &&
        (validImage(512 * 1024) || validDocument(10 * 1024 * 1024));
      allow delete: if request.auth.uid == userId || admin();
    }

    match /omr/{userId}/{fileName} {
      allow read: if signedIn() && (request.auth.uid == userId || teacher());
      allow create, update: if request.auth.uid == userId && validImage(5 * 1024 * 1024);
      allow delete: if request.auth.uid == userId || admin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
